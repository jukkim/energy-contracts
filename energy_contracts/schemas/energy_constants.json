{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-contracts/energy_constants.json",
  "title": "Energy Constants",
  "description": "에너지 기준값·등급·환산계수 SSOT. ENERGY_SSOT.md §2~§3 기반.",
  "_usage": "codegen",
  "_consumers": [
    "building-energy-3d"
  ],
  "version": "2.1",
  "type": "object",
  "properties": {
    "pe_factors": {
      "type": "object",
      "description": "1차에너지 환산계수 (무차원). 국토부고시 제2024-1026호 (2025.1.1 시행)",
      "properties": {
        "electricity": {
          "type": "number"
        },
        "gas": {
          "type": "number"
        },
        "district_heat": {
          "type": "number"
        },
        "district_cool": {
          "type": "number"
        }
      }
    },
    "zeb": {
      "type": "object",
      "description": "ZEB 등급 기준 (녹색건축법, 2025.1.1 통합인증). min_self_sufficiency_pct=에너지자립률(%)=공식 ZEB 등급 결정 기준(Plus120/1:100/2:80/3:60/4:40/5:20, 20%p 밴드, zeb.energy.or.kr 2026-06-21 재확인). max_pe_kwh=본 시스템 EUI-proxy(baseline150×ratio, 비공식 근사). 공식 1차에너지소요량은 주거/비주거 별도표(음수 포함). 의무화 임계 1,000m²(공공 2025.1.1 / 민간 일반 2025.12.31).",
      "properties": {
        "baseline_kwh_m2_yr": {
          "type": "number",
          "description": "에너지절약설계기준 1차에너지 상한"
        },
        "grades": {
          "type": "object",
          "description": "ZEB 등급별 상한 (kWh/m2/yr) 및 자립률",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "max_pe_kwh": {
                "type": "number"
              },
              "min_self_sufficiency_pct": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "energy_grades": {
      "type": "object",
      "description": "에너지효율등급 (1+++~5)",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "등급 라벨 (순서: 최고→최저)"
        },
        "colors": {
          "type": "object",
          "description": "등급별 CSS hex 색상",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "co2_grades": {
      "type": "object",
      "description": "CO2 배출 등급 임계값",
      "properties": {
        "thresholds_kgco2_m2_yr": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "4단계 분류 경계값"
        }
      }
    },
    "climate": {
      "type": "object",
      "description": "기후 관련 기준값",
      "properties": {
        "hdd_base_temp_c": {
          "type": "number"
        },
        "cdd_base_temp_c": {
          "type": "number"
        },
        "kr_bbox": {
          "type": "object",
          "properties": {
            "lat_min": {
              "type": "number"
            },
            "lat_max": {
              "type": "number"
            },
            "lng_min": {
              "type": "number"
            },
            "lng_max": {
              "type": "number"
            }
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "description": "시뮬레이션 공통 파라미터. ENERGY_SSOT.md §6.",
      "properties": {
        "cooling_setpoint_c": {
          "type": "number"
        },
        "heating_setpoint_c": {
          "type": "number"
        },
        "chiller_cop": {
          "type": "number"
        },
        "boiler_efficiency": {
          "type": "number"
        },
        "energyplus_version": {
          "type": "string"
        },
        "pv_efficiency_pct": {
          "type": "number"
        },
        "pv_performance_ratio": {
          "type": "number"
        },
        "rooftop_utilization": {
          "type": "number"
        }
      }
    },
    "ndc_targets": {
      "type": "object",
      "description": "국가 온실가스 감축목표(NDC) — 국가 전체와 부문별을 **다른 키**로 둔다(2026-09-28 추가). 국가 전체 −40% 는 국가 전체 맥락에서만, 건물 한 동·건물군·시군구 건물 배출의 목표는 건물부문 값을 쓴다. 두 값을 섞지 않는다. 값은 외부 공식 발표(data_source=external)이며 출처·발표일을 항목마다 싣는다.",
      "required": ["default_target", "targets"],
      "properties": {
        "default_target": {
          "type": "string",
          "description": "건물 배출 맥락의 기본 목표 키(targets 의 키). 국가 전체 질문은 national_2030 을 명시해 고른다."
        },
        "building_sector_inventory": {
          "type": "object",
          "description": "국가 건물부문 배출 인벤토리(직접 배출만, 백만 tCO2eq) — 건물부문 NDC 와 같은 범위(2026-09-29 Query100 C02·C03). 지역 2018 기준 추정의 국가 추세. 연도 키는 문자열.",
          "required": ["scope", "emissions_mtco2eq", "data_source", "sources"],
          "properties": {
            "scope": {"type": "string", "enum": ["direct_only"]},
            "scope_ko": {"type": "string"},
            "emissions_mtco2eq": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
            "provisional_years": {"type": "array", "items": {"type": "integer"}},
            "data_source": {"type": "string"},
            "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["year", "source_title", "source_url", "source_date"]}},
            "retrieved": {"type": "string"},
            "cross_check": {"type": "string"},
            "use": {"type": "string"}
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["scope", "base_year", "target_year", "label_ko", "data_source", "source_title", "source_url", "source_date"],
            "properties": {
              "scope": {"type": "string", "enum": ["national", "building"], "description": "national=국가 전체 순배출 / building=건물부문."},
              "base_year": {"type": "integer"},
              "target_year": {"type": "integer"},
              "label_ko": {"type": "string", "description": "사람 대면 표기(출처 칸에 그대로 쓴다)."},
              "reduction_rate": {"type": "number", "minimum": 0, "maximum": 1, "description": "기준연도 대비 감축률(0~1, 양수=감축). 범위 목표면 비우고 min/max 를 쓴다."},
              "reduction_rate_min": {"type": "number", "minimum": 0, "maximum": 1},
              "reduction_rate_max": {"type": "number", "minimum": 0, "maximum": 1},
              "base_emissions_mtco2eq": {"type": "number", "description": "기준연도 배출량(백만 tCO2eq). 발표에 있을 때만."},
              "target_emissions_mtco2eq": {"type": "number", "description": "목표연도 배출량(백만 tCO2eq). 발표에 있을 때만."},
              "status": {"type": "string", "description": "확정 단계(예: 국무회의 확정)."},
              "data_source": {"type": "string", "description": "data_classification.json#DataSource — 공식 발표 = external."},
              "source_title": {"type": "string"},
              "source_url": {"type": "string"},
              "source_date": {"type": "string", "format": "date", "description": "발표·확정일."},
              "retrieved": {"type": "string", "format": "date", "description": "EC 등재 시 원문 확인일."},
              "note": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "default": {
    "pe_factors": {
      "electricity": 2.75,
      "gas": 1.1,
      "district_heat": 0.728,
      "district_cool": 0.937
    },
    "zeb": {
      "baseline_kwh_m2_yr": 150.0,
      "grades": {
        "1": {
          "max_pe_kwh": 30,
          "min_self_sufficiency_pct": 100
        },
        "2": {
          "max_pe_kwh": 60,
          "min_self_sufficiency_pct": 80
        },
        "3": {
          "max_pe_kwh": 90,
          "min_self_sufficiency_pct": 60
        },
        "4": {
          "max_pe_kwh": 120,
          "min_self_sufficiency_pct": 40
        },
        "5": {
          "max_pe_kwh": 150,
          "min_self_sufficiency_pct": 20
        },
