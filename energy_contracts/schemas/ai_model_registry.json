{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-contracts/ai_model_registry.json",
  "title": "AI Model Registry SSOT (Phase I-1)",
  "description": "8.simulation 13종 AI 모델 카탈로그 — Korean_BB, ems_transformer, building_ai 7종, factory_ai 13 등. 카르테 UI · 모델 마켓플레이스 · API /models/list SSOT.",
  "_usage": "codegen",
  "_consumers": [
    "edge-agent",
    "gridbridge",
    "building-energy-3d",
    "agentleague",
    "eduarena"
  ],
  "version": "1.2",
  "updated": "2026-09-12",
  "$comment": "Phase I-1 산출물 + AI 챔피언 본선 hash freeze (PRD v1.5 Track 3 G0). v1.1 = active_checkpoint + sha256 + frozen_for_demo 신설. v1.2 (사용자 결정 #6, 2026-05-29) = lifecycle 필드 enum 신설 (active / rollback_only / training_pending / locked / deprecated). registry_loader 5.3 LOCKED 강제 invariant 와 동기.",
  "$defs": {
    "ModelTask": {
      "type": "string",
      "enum": [
        "forecast",
        "anomaly",
        "predict",
        "classify",
        "rul",
        "optimize",
        "diagnose"
      ]
    },
    "ModelFramework": {
      "type": "string",
      "enum": [
        "xgboost",
        "lightgbm",
        "patchtst",
        "transformer",
        "isolation_forest",
        "lstm_autoencoder",
        "sklearn",
        "prophet",
        "tabnet",
        "energyplus"
      ]
    },
    "ModelEntry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "task",
        "framework"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string"
        },
        "name_kr": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "체크포인트 상대 경로 (workspace root 기준)"
        },
        "task": {
          "$ref": "#/$defs/ModelTask"
        },
        "framework": {
          "$ref": "#/$defs/ModelFramework"
        },
        "input_shape": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "output_shape": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "accuracy_metric": {
          "type": "object",
          "description": "지표명 → 값. 예: {nrmse_pct: 12.3, mae: 0.05, f1: 0.92}",
          "additionalProperties": {
            "type": "number"
          }
        },
        "data_source": {
          "type": "string",
          "enum": [
            "measured",
            "certified",
            "simulated",
            "predicted",
            "external",
            "synthetic",
            "mock"
          ]
        },
        "trained_at": {
          "type": "string",
          "format": "date"
        },
        "frozen": {
          "type": "boolean",
          "default": false,
          "description": "true 시 변경 금지 (논문 투고·인증 중)"
        },
        "project": {
          "type": "string",
          "description": "8.simulation 하위 폴더"
        },
        "description": {
          "type": "string"
        },
        "active_checkpoint": {
          "type": "string",
          "description": "v1.1 추가 — 백엔드 health response 의 checkpoint 식별자와 매칭. Gateway startup_check 가 검증 (mismatch 시 startup ERROR). PRD v1.5 Track 3 G0."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "v1.1 추가 — 모델 파일 sha256. 선택 사항 (active_checkpoint name 매칭 우선)."
        },
        "backend_url": {
          "type": "string",
          "description": "v1.1 추가 — 백엔드 base URL (예: http://localhost:8040). Gateway adapter 가 호출."
        },
        "retrain_type": {
          "type": "string",
          "enum": [
            "type_1_sim",
            "type_2_real"
          ],
          "description": "v1.1 추가 — Type 1(시뮬 학습, 수동만) vs Type 2(실측, 자동 가능). UNIFIED_GATEWAY_DESIGN §8.5."
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "rollback_only",
            "training_pending",
            "locked",
            "deprecated"
          ],
          "default": "active",
          "description": "v1.2 추가 (사용자 결정 #6, 2026-05-29) — 모델 운영 lifecycle. **active**: 운영 traffic 처리. **rollback_only**: 운영 진입 금지, rollback target 만 (예: v2.5-pre Phase K G6 미통과). **training_pending**: 학습 진입 자격 미확정 (예: KBEP, ECMHS). **locked**: frozen baseline (예: Korean_BB v1.0 Energy & AI 투고). **deprecated**: 폐기 예정. Gateway routing 시 본 필드 권위 — `active` 외 모델로 traffic 가 들어가면 startup_check ERROR."
        },
        "training_domain": {
          "type": "object",
          "additionalProperties": false,
          "description": "2026-10-04 — 모델이 학습한 자료의 영역(축별). 게이트웨이 학습 영역 대조(measured_store_analysis._model_domain)가 자산 속성과 견준다. 선언하지 않은 축은 '등록 없음'(못 잼). 값은 학습 자료 원본에서 확인한 사실만.",
          "properties": {
            "use_type": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "학습 자료의 건물 용도(자산 기록 use_type 낱말과 같은 낱말)"
            },
            "gross_area_m2": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "description": "학습 자료 연면적 범위(㎡)"
            },
            "region": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "학습 자료의 나라 코드(ISO 3166-1 alpha-2, 예: KR)"
            },
            "resolution": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "hourly",
                  "daily",
                  "monthly"
                ]
              },
              "description": "입력 자료 시간 해상도"
            },
            "basis_ko": {
              "type": "string",
              "description": "각 축 값의 근거(학습 자료·설정 파일)"
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "근거 파일 경로"
            },
            "outdoor_temp_c": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "description": "학습 기상 자료(EPW)의 외기 건구온도 범위(℃) — 게이트웨이가 자산 기간의 시간별 외기온과 견줘 범위 밖 시간 구간을 경고한다"
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "properties": {
    "models": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ModelEntry"
      }
    },
    "frozen_for_demo": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "v1.1 추가 — 본선 시연용 freeze 모델 ID 목록. 본선 시점 Release Bundle manifest 가 이 목록을 참조. PRD v1.5 §4.2 + Track 3 G0. Gateway startup_check 가 이 모델들의 active_checkpoint 일치를 강제 검증."
    },
    "gateway_verify_policy": {
      "type": "string",
      "enum": [
        "strict",
        "warn",
        "off"
      ],
      "default": "warn",
      "description": "v1.1 추가 — Gateway startup_check 의 검증 정책. strict=ERROR 차단, warn=alert 후 통과, off=비활성. 본선 시점 = strict, 개발 = warn."
    }
  },
