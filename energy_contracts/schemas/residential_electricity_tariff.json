{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-contracts/residential_electricity_tariff.json",
  "title": "ResidentialElectricityTariff",
  "description": "주택용 전력 **누진 구간 요금표**(한국전력 전기공급약관 별표 · 주택용 저압/고압). 가정은 시간대 요금 신호가 아니라 월 사용량 누진제로 요금이 매겨지고, 가구는 자기가 지금 몇 구간인지 거의 모른다(2026-10-14 사용자) — 화면이 '이번 달 지금 구간 · 다음 구간까지 남은 kWh' 를 알려 주는 정본. ⚠ `market_prices.json` 의 주택용 단가는 대표 평균 하나(누진 세분 없음)이고 이 표와 섞지 않는다. ⚠ 이 표는 **기본요금·전력량요금만** 담는다 — 기후환경요금·연료비조정요금·부가가치세·전력산업기반기금·필수사용량 보장공제·복지할인은 없으므로 이 값으로 청구서를 재현했다고 말하지 않는다(구간 판정과 구간 단가 안내용).",
  "_usage": "runtime-validate",
  "_consumers": [
    "airos-energy-decision"
  ],
  "version": "1.0",
  "type": "object",
  "$defs": {
    "Tier": {
      "type": "object",
      "required": ["tier", "upper_kwh", "basic_charge_krw", "energy_charge_krw_per_kwh"],
      "properties": {
        "tier": {"type": "integer", "minimum": 1, "maximum": 3, "description": "누진 구간 번호(1·2·3)"},
        "upper_kwh": {"type": ["number", "null"], "minimum": 0, "description": "이 구간의 월 사용량 상한(이하, kWh). 마지막 구간은 null(상한 없음)"},
        "basic_charge_krw": {"type": "number", "minimum": 0, "description": "기본요금(원/호) — 월 사용량이 속한 구간의 값 하나만 부과"},
        "energy_charge_krw_per_kwh": {"type": "number", "minimum": 0, "description": "전력량요금(원/kWh) — 각 구간에 든 사용량만큼 그 구간 단가(누진 계단)"}
      },
      "additionalProperties": false
    },
    "SeasonTable": {
      "type": "object",
      "required": ["months", "tiers"],
      "properties": {
        "months": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 12}, "minItems": 1, "description": "이 구간 경계를 쓰는 달(검침 월 기준)"},
        "tiers": {"type": "array", "items": {"$ref": "#/$defs/Tier"}, "minItems": 3, "maxItems": 3}
      },
      "additionalProperties": false
    },
    "VoltageTable": {
      "type": "object",
      "required": ["label_ko", "seasons", "super_user"],
      "properties": {
        "label_ko": {"type": "string"},
        "seasons": {
          "type": "object",
          "required": ["summer", "other"],
          "properties": {"summer": {"$ref": "#/$defs/SeasonTable"}, "other": {"$ref": "#/$defs/SeasonTable"}},
          "additionalProperties": false
        },
        "super_user": {
          "type": "object",
          "required": ["months", "threshold_kwh", "energy_charge_krw_per_kwh"],
          "description": "슈퍼유저 요금 — 지정 달에 월 사용량이 문턱을 넘으면 넘은 사용량에 적용",
          "properties": {
            "months": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 12}},
            "threshold_kwh": {"type": "number", "minimum": 0},
            "energy_charge_krw_per_kwh": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "source": {"type": "object"},
    "low_voltage": {"$ref": "#/$defs/VoltageTable"},
    "high_voltage": {"$ref": "#/$defs/VoltageTable"},
    "excluded_charges_ko": {"type": "array", "items": {"type": "string"}}
  },
  "default": {
    "source": {
      "publisher": "한국전력공사",
      "title": "전기요금표 — 주택용 전력(저압·고압)",
      "url": "https://cyber.kepco.co.kr/ckepco/front/jsp/CY/E/E/CYEEHP00101.jsp",
      "effective_date": "2023-11-09",
      "verified_at": "2026-10-14",
      "note_ko": "한전 요금표 페이지에서 2026-10-14 확인(표 시행일 2023-11-09). 요금이 바뀌면 이 블록과 version 을 함께 고친다."
    },
    "low_voltage": {
      "label_ko": "주택용 전력(저압)",
      "seasons": {
        "summer": {"months": [7, 8], "tiers": [
          {"tier": 1, "upper_kwh": 300, "basic_charge_krw": 910, "energy_charge_krw_per_kwh": 120.0},
          {"tier": 2, "upper_kwh": 450, "basic_charge_krw": 1600, "energy_charge_krw_per_kwh": 214.6},
          {"tier": 3, "upper_kwh": null, "basic_charge_krw": 7300, "energy_charge_krw_per_kwh": 307.3}
        ]},
        "other": {"months": [1, 2, 3, 4, 5, 6, 9, 10, 11, 12], "tiers": [
          {"tier": 1, "upper_kwh": 200, "basic_charge_krw": 910, "energy_charge_krw_per_kwh": 120.0},
          {"tier": 2, "upper_kwh": 400, "basic_charge_krw": 1600, "energy_charge_krw_per_kwh": 214.6},
          {"tier": 3, "upper_kwh": null, "basic_charge_krw": 7300, "energy_charge_krw_per_kwh": 307.3}
        ]}
      },
      "super_user": {"months": [7, 8, 12, 1, 2], "threshold_kwh": 1000, "energy_charge_krw_per_kwh": 736.2}
    },
    "high_voltage": {
      "label_ko": "주택용 전력(고압)",
      "seasons": {
        "summer": {"months": [7, 8], "tiers": [
          {"tier": 1, "upper_kwh": 300, "basic_charge_krw": 730, "energy_charge_krw_per_kwh": 105.0},
          {"tier": 2, "upper_kwh": 450, "basic_charge_krw": 1260, "energy_charge_krw_per_kwh": 174.0},
          {"tier": 3, "upper_kwh": null, "basic_charge_krw": 6060, "energy_charge_krw_per_kwh": 242.3}
        ]},
        "other": {"months": [1, 2, 3, 4, 5, 6, 9, 10, 11, 12], "tiers": [
          {"tier": 1, "upper_kwh": 200, "basic_charge_krw": 730, "energy_charge_krw_per_kwh": 105.0},
          {"tier": 2, "upper_kwh": 400, "basic_charge_krw": 1260, "energy_charge_krw_per_kwh": 174.0},
          {"tier": 3, "upper_kwh": null, "basic_charge_krw": 6060, "energy_charge_krw_per_kwh": 242.3}
        ]}
      },
      "super_user": {"months": [7, 8, 12, 1, 2], "threshold_kwh": 1000, "energy_charge_krw_per_kwh": 593.3}
    },
    "excluded_charges_ko": ["기후환경요금", "연료비조정요금", "부가가치세", "전력산업기반기금", "필수사용량 보장공제", "복지·대가족 할인"]
  }
}
