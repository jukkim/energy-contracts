{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-contracts/auth_scopes.json",
  "title": "Auth Scopes & RBAC SSOT (Phase I-2)",
  "description": "워크스페이스 공통 RBAC. edge-agent admin/operator/technician + AgentLeague admin + EduArena student/teacher/admin + building-energy-3d guest 통합. permissions 매트릭스는 verb:resource 라벨.",
  "_usage": "codegen",
  "_consumers": [
    "edge-agent",
    "gridbridge",
    "building-energy-3d",
    "agentleague",
    "eduarena",
    "airos-energy-decision",
    "ems-transformer",
    "energy-decision-studio",
    "building-energy-3d-lab"
  ],
  "version": "1.2",
  "updated": "2026-09-27",
  "$defs": {
    "Scope": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "operator",
        "technician",
        "teacher",
        "student",
        "guest"
      ]
    },
    "Permission": {
      "type": "string",
      "pattern": "^(read|write|delete|exec):[a-z_]+$",
      "description": "verb:resource (예: write:portfolio, read:telemetry)"
    }
  },
  "type": "object",
  "properties": {
    "scopes": {
      "type": "object"
    },
    "permissions": {
      "type": "object"
    },
    "project_default_scopes": {
      "type": "object"
    },
    "resource_authorization": {
      "type": "object",
      "description": "Verified AIROS identity capabilities intersected with the current assigned asset snapshot; never inherits global RBAC roles."
    }
  },
  "default": {
    "scopes": {
      "super_admin": {
        "description": "전 워크스페이스 관리자",
        "includes": [
          "admin",
          "operator",
          "technician",
          "teacher"
        ]
      },
      "admin": {
        "description": "프로젝트 전권"
      },
      "operator": {
        "description": "일상 모니터링·제어 (read + write strategy/telemetry)"
      },
      "technician": {
        "description": "설치·구성 변경 (write edge_config + seal bundle)"
      },
      "teacher": {
        "description": "EduArena 강의 운영 (write classroom + read metrics)"
      },
      "student": {
        "description": "EduArena 학습자 (write submission)"
      },
      "guest": {
        "description": "DEMO 모드 읽기 전용"
      }
    },
    "permissions": {
      "read:telemetry": [
        "admin",
        "operator",
        "technician",
        "guest"
      ],
      "write:telemetry": [
        "admin",
        "operator"
      ],
      "read:portfolio": [
        "admin",
        "operator",
        "guest"
      ],
      "write:portfolio": [
        "admin"
      ],
      "delete:portfolio": [
        "admin"
      ],
      "write:edge_config": [
        "admin",
        "technician"
      ],
      "exec:edge_seal": [
        "admin",
        "technician"
      ],
      "write:strategy": [
        "admin",
        "operator"
      ],
      "exec:dispatch": [
        "admin",
        "operator"
      ],
      "read:metrics": [
        "admin",
        "operator",
        "teacher"
      ],
      "write:classroom": [
        "admin",
        "teacher"
      ],
      "write:submission": [
        "admin",
        "teacher",
        "student"
      ],
      "read:agent": [
        "admin",
        "operator",
        "teacher",
        "guest"
      ],
      "write:agent": [
        "admin"
      ],
      "exec:simulation": [
        "admin",
        "operator"
      ],
      "read:carbon_price": [
        "admin",
        "operator",
        "guest"
      ],
      "write:carbon_price": [
        "admin"
      ]
    },
    "project_default_scopes": {
      "building-energy-3d": [
        "admin",
        "operator",
        "guest"
      ],
      "edge-agent": [
        "admin",
        "operator",
        "technician"
      ],
      "gridbridge": [
        "admin",
        "operator"
      ],
      "agentleague": [
        "admin",
        "operator",
        "guest"
      ],
      "eduarena": [
        "admin",
        "teacher",
        "student",
        "guest"
      ]
    },
    "demo_mode_fallback": {
      "description": "RUN_MODE=demo 시 인증 누락 요청에 자동 적용할 scope",
      "scope": "guest"
    },
    "resource_authorization": {
      "version": "1.1",
      "identity_authority": "airos",
      "scope": "assigned_assets_only",
      "unknown_role": "deny",
      "unknown_action": "deny",
      "execution_authorized": false,
      "roles": {
        "analyst": {
          "permissions": [
            "read:asset",
            "analyze:asset"
          ],
          "inherits": []
        },
        "building_manager": {
          "permissions": [
            "read:asset",
            "analyze:asset"
          ],
          "inherits": []
        },
        "home_owner": {
          "permissions": [
            "read:asset",
            "analyze:asset",
            "write:home_consent",
            "revoke:home_consent",
            "write:home_protection"
          ],
          "inherits": []
        },
        "platform_admin": {
          "permissions": [
            "read:asset",
            "analyze:asset",
            "write:asset_record"
          ],
          "inherits": []
        },
        "policy_official": {
          "permissions": [
            "read:asset",
            "analyze:asset"
          ],
          "inherits": []
        },
        "portfolio_manager": {
          "permissions": [
            "read:asset",
            "analyze:asset"
          ],
          "inherits": []
        }
      },
      "actions": {
        "read:asset": {
          "effect": "allow_with_assignment"
        },
        "analyze:asset": {
          "effect": "allow_with_assignment"
        },
        "approve:action": {
          "effect": "deny",
          "reason_code": "AUTHORIZATION_CONDITIONS_UNDEFINED"
        },
        "exec:dispatch": {
          "effect": "deny",
          "reason_code": "AUTHORIZATION_CONDITIONS_UNDEFINED"
        },
        "write:asset_record": {
          "effect": "allow_with_assignment",
          "basis": "Existing AIROS admin asset record/identity routes require platform_admin and the same assigned asset."
        },
        "write:home_consent": {
          "effect": "allow_with_assignment",
          "required_asset_class": "HOM",
          "contract_ref": "household_consent.json#/$defs/ConsentRequest",
          "basis": "The registered household owner selects, withdraws or changes protection for their own household. This does not authorize dispatch or approval."
        },
        "revoke:home_consent": {
          "effect": "allow_with_assignment",
          "required_asset_class": "HOM",
          "contract_ref": "household_consent.json#/$defs/ParticipationState",
          "basis": "The registered household owner selects, withdraws or changes protection for their own household. This does not authorize dispatch or approval."
        },
        "write:home_protection": {
          "effect": "allow_with_assignment",
          "required_asset_class": "HOM",
          "contract_ref": "household_consent.json#/$defs/ProtectionState",
          "basis": "The registered household owner selects, withdraws or changes protection for their own household. This does not authorize dispatch or approval."
        }
      },
      "description": "Current assigned-resource capabilities. AIROS roles are independent of global admin/operator roles. Home participation/protection belongs to the assigned home_owner; platform_admin asset metadata writes preserve existing route authority. No approval, dispatch or broader write grant is implied. Service credentials and declared personas are not user identity."
    }
  }
}
