{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-contracts/auth_scopes.json",
  "title": "Auth Scopes & RBAC SSOT (Phase I-2)",
  "description": "워크스페이스 공통 RBAC. edge-agent admin/operator/technician + AgentLeague admin + EduArena student/teacher/admin + building-energy-3d guest 통합. permissions 매트릭스는 verb:resource 라벨.",
  "_usage": "codegen",
  "_consumers": [
    "edge-agent",
    "gridbridge",
    "building-energy-3d",
    "agentleague",
    "eduarena",
    "airos-energy-decision",
    "ems-transformer",
    "energy-decision-studio",
    "building-energy-3d-lab"
  ],
  "version": "1.4",
  "updated": "2026-09-28",
  "$defs": {
    "Scope": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "operator",
        "technician",
        "teacher",
        "student",
        "guest"
      ]
    },
    "Permission": {
      "type": "string",
      "pattern": "^(read|write|delete|exec):[a-z_]+$",
      "description": "verb:resource (예: write:portfolio, read:telemetry)"
    },
    "ResourceActionRule": {
      "type": "object",
      "required": [
        "effect"
      ],
      "properties": {
        "effect": {
          "type": "string",
          "enum": [
            "allow_with_assignment",
            "allow_with_assignment_and_conditions",
            "deny"
          ],
          "description": "allow_with_assignment = 역할 권한 + 배정 자산이면 허용. allow_with_assignment_and_conditions = 거기에 conditions 를 모두 평가해 통과해야 허용 — 조건을 평가하지 못하는 소비처는 이 값을 allow_with_assignment 와 다르게 보므로 거부한다(판정 모듈 energy_contracts._utils.resource_authorization). deny = 항상 거부."
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "description": "effect 가 allow_with_assignment 가 아닐 때 조건을 평가하지 못하는 소비처가 돌려줄 거절 이름."
        },
        "required_asset_class": {
          "type": "string"
        },
        "contract_ref": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "decided": {
          "type": "string",
          "format": "date"
        },
        "grants_execution": {
          "const": false,
          "description": "승인은 실행이 아니다. 실행(exec:dispatch)은 별도 행동이다."
        },
        "conditions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "description": "모든 조건을 평가해 통과해야 허용. 알려지지 않은 조건 키는 판정 모듈이 거부한다(AUTHORIZATION_CONDITIONS_UNEVALUATED).",
          "properties": {
            "action_kind": {
              "type": "object",
              "required": [
                "vocabulary_ref",
                "match"
              ],
              "additionalProperties": false,
              "properties": {
                "vocabulary_ref": {
                  "type": "string",
                  "const": "measure_cost_catalog.json#/default/measures",
                  "description": "승인 대상 조치 종류의 어휘. 절감 조치 = 조치 경제성 카탈로그(MACC)의 조치 코드."
                },
                "match": {
                  "const": "key"
                },
                "additional_kinds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z_]*$"
                  },
                  "description": "카탈로그 밖에서 절감 조치로 인정한 운영 조치 종류(사용자 결정). 허용 목록 = vocabulary_ref 의 키 ∪ 이 목록 — 판정 모듈 allowed_action_kinds() 한 곳에서만 합친다."
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "allow_with_assignment_and_conditions"
              }
            }
          },
          "then": {
            "required": [
              "conditions",
              "reason_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "deny"
              }
            }
          },
          "then": {
            "required": [
              "reason_code"
            ]
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "scopes": {
      "type": "object"
    },
    "permissions": {
      "type": "object"
    },
    "project_default_scopes": {
      "type": "object"
    },
    "resource_authorization": {
      "type": "object",
      "description": "Verified AIROS identity capabilities intersected with the current assigned asset snapshot; never inherits global RBAC roles.",
      "properties": {
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ResourceActionRule"
          }
        }
      }
    }
  },
  "default": {
    "scopes": {
      "super_admin": {
        "description": "전 워크스페이스 관리자",
        "includes": [
          "admin",
          "operator",
          "technician",
          "teacher"
        ]
      },
      "admin": {
        "description": "프로젝트 전권"
      },
      "operator": {
        "description": "일상 모니터링·제어 (read + write strategy/telemetry)"
      },
      "technician": {
        "description": "설치·구성 변경 (write edge_config + seal bundle)"
      },
      "teacher": {
        "description": "EduArena 강의 운영 (write classroom + read metrics)"
      },
      "student": {
        "description": "EduArena 학습자 (write submission)"
      },
      "guest": {
        "description": "DEMO 모드 읽기 전용"
      }
    },
    "permissions": {
      "read:telemetry": [
        "admin",
        "operator",
        "technician",
        "guest"
      ],
      "write:telemetry": [
        "admin",
        "operator"
      ],
      "read:portfolio": [
        "admin",
        "operator",
        "guest"
      ],
      "write:portfolio": [
        "admin"
      ],
      "delete:portfolio": [
        "admin"
      ],
      "write:edge_config": [
        "admin",
        "technician"
      ],
      "exec:edge_seal": [
        "admin",
        "technician"
      ],
      "write:strategy": [
        "admin",
        "operator"
      ],
      "exec:dispatch": [
        "admin",
        "operator"
      ],
      "read:metrics": [
        "admin",
        "operator",
        "teacher"
      ],
      "write:classroom": [
        "admin",
        "teacher"
      ],
      "write:submission": [
        "admin",
        "teacher",
        "student"
      ],
      "read:agent": [
        "admin",
        "operator",
        "teacher",
        "guest"
      ],
      "write:agent": [
        "admin"
      ],
      "exec:simulation": [
        "admin",
        "operator"
      ],
      "read:carbon_price": [
        "admin",
        "operator",
        "guest"
      ],
      "write:carbon_price": [
        "admin"
      ]
    },
    "project_default_scopes": {
      "building-energy-3d": [
        "admin",
        "operator",
        "guest"
      ],
      "edge-agent": [
        "admin",
        "operator",
        "technician"
      ],
      "gridbridge": [
        "admin",
        "operator"
      ],
      "agentleague": [
        "admin",
        "operator",
        "guest"
      ],
      "eduarena": [
        "admin",
        "teacher",
        "student",
        "guest"
      ]
    },
    "demo_mode_fallback": {
      "description": "RUN_MODE=demo 시 인증 누락 요청에 자동 적용할 scope",
      "scope": "guest"
    },
    "resource_authorization": {
      "version": "1.3",
      "identity_authority": "airos",
      "scope": "assigned_assets_only",
      "unknown_role": "deny",
      "unknown_action": "deny",
      "execution_authorized": false,
      "roles": {
        "analyst": {
          "permissions": [
            "read:asset",
            "analyze:asset"
          ],
          "inherits": []
        },
        "building_manager": {
          "permissions": [
            "read:asset",
            "analyze:asset"
          ],
          "inherits": []
        },
        "home_owner": {
          "permissions": [
            "read:asset",
            "analyze:asset",
            "write:home_consent",
            "revoke:home_consent",
            "write:home_protection"
          ],
          "inherits": []
        },
        "platform_admin": {
          "permissions": [
            "read:asset",
            "analyze:asset",
            "write:asset_record"
          ],
          "inherits": []
        },
        "policy_official": {
          "permissions": [
            "read:asset",
            "analyze:asset"
          ],
          "inherits": []
        },
        "portfolio_manager": {
          "permissions": [
            "read:asset",
            "analyze:asset",
            "approve:action"
          ],
          "inherits": []
        }
      },
      "actions": {
        "read:asset": {
          "effect": "allow_with_assignment"
        },
        "analyze:asset": {
          "effect": "allow_with_assignment"
        },
        "approve:action": {
          "effect": "allow_with_assignment_and_conditions",
          "reason_code": "AUTHORIZATION_CONDITIONS_UNEVALUATED",
          "conditions": {
            "action_kind": {
              "vocabulary_ref": "measure_cost_catalog.json#/default/measures",
              "match": "key",
              "additional_kinds": [
                "check_action",
                "schedule_change"
              ]
            }
          },
          "grants_execution": false,
          "decided": "2026-09-28",
          "basis": "User decision 2026-09-28 16:39: a portfolio_manager may approve savings measures (measure_cost_catalog.json measure codes) on assets currently assigned to them. User decision 2026-09-28 16:56: the portfolio operational action kinds check_action and schedule_change also count as savings measures; setpoint_change stays denied (no setpoint limit was decided). Approval is not execution: exec:dispatch stays denied for every role, and any action that is not a registered savings measure (control, contract, data changes) is denied. A consumer that cannot evaluate every listed condition must deny."
        },
        "exec:dispatch": {
          "effect": "deny",
          "reason_code": "AUTHORIZATION_CONDITIONS_UNDEFINED"
        },
        "write:asset_record": {
          "effect": "allow_with_assignment",
          "basis": "Existing AIROS admin asset record/identity routes require platform_admin and the same assigned asset."
        },
        "write:home_consent": {
          "effect": "allow_with_assignment",
          "required_asset_class": "HOM",
          "contract_ref": "household_consent.json#/$defs/ConsentRequest",
          "basis": "The registered household owner selects, withdraws or changes protection for their own household. This does not authorize dispatch or approval."
        },
        "revoke:home_consent": {
          "effect": "allow_with_assignment",
          "required_asset_class": "HOM",
          "contract_ref": "household_consent.json#/$defs/ParticipationState",
          "basis": "The registered household owner selects, withdraws or changes protection for their own household. This does not authorize dispatch or approval."
        },
        "write:home_protection": {
          "effect": "allow_with_assignment",
          "required_asset_class": "HOM",
          "contract_ref": "household_consent.json#/$defs/ProtectionState",
          "basis": "The registered household owner selects, withdraws or changes protection for their own household. This does not authorize dispatch or approval."
        }
      },
      "description": "Current assigned-resource capabilities. AIROS roles are independent of global admin/operator roles. Home participation/protection belongs to the assigned home_owner; platform_admin asset metadata writes preserve existing route authority. Only portfolio_manager may approve, and only registered savings measures on assigned assets (2026-09-28 user decision); approval never authorizes dispatch, and no broader write grant is implied. Service credentials and declared personas are not user identity."
    }
  }
}
