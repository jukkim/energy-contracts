  "_consumers": [
    "building-energy-3d",
    "8sim-shared (drift-guard read-only: ems_transformer kbep_client._CITY_TO_ID 대조)"
  ],
  "version": "2.1",
  "type": "object",
  "properties": {
    "simulation_cities": {
      "type": "object",
      "description": "시뮬레이션 도시 코드 C01~C18 (C12~C18 = 2026-07-11 KEP 도시확장)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name_en": {
            "type": "string"
          },
          "name_kr": {
            "type": "string"
          },
          "kbep_city_id": {
            "type": "integer",
            "description": "KBEP/F14 city_id 인코딩 (0-base, C01=0 … C18=17). ems_transformer kbep_client._CITY_TO_ID 및 KBEP :8020 city_id 바운드(le=17)와 정합"
          },
          "climate_zone": {
            "type": "string",
            "description": "한국 기후구역 (중부1/중부2/남부/제주)"
          },
          "solar_kwh_m2_yr": {
            "type": "number",
            "description": "연평균 수평면 전일사량"
          }
        }
      }
    },
    "hvac_types": {
      "type": "object",
      "description": "HVAC 유형 코드 H_A~H_G. NAMING_UNIFICATION.md §3.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sim_id": {
            "type": "string",
            "description": "sim_id 내 2자리 코드"
          },
          "name_en": {
            "type": "string"
          },
          "name_kr": {
            "type": "string"
          },
          "cooling": {
