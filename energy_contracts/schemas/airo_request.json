              "type": [
                "string",
                "null"
              ],
              "pattern": "^B(0[1-9]|1[0-8])$"
            },
            "hvac": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^H_[A-G]$"
            },
            "usage": {
              "type": [
                "string",
                "null"
              ]
            },
            "gross_floor_area_m2": {
              "type": [
                "number",
                "null"
              ]
            },
            "building_mgmt_no": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{25}$"
            },
            "parcel_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{19}$"
            },
            "identity_status": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "attribute_sources": {
          "type": "object",
          "description": "속성 이름 → {source: record|registry|derived|default|question, absence_kind?, flag?}",
          "additionalProperties": {
            "type": "object",
