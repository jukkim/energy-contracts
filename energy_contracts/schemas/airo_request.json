{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-contracts/airo_request.json",
  "title": "AIRO 공통 요청 봉투 (airo-request/v2)",
  "description": "다섯 응용(게이트웨이·MCP·AIROS·AgentLeague·Studio·Lab)의 질의형 입구가 받는 하나의 봉투. 누가(asker)·무엇을(target)·언제(period)를 싣는다. LLM 함수 호출 스키마에는 target(서버가 정한 것)·period.text·질문이 정할 값만 보이고, 자료·정본 참조·표지·서버 산출물 참조는 서버 결속기가 채운다. 근거: 공모전 docs/API_UNIFICATION_PROPOSAL_2026-09-22.md, docs/QUERY_ASKER_TOP_LEVEL_RULE_2026-09-22.md.",
  "_usage": "runtime-validate",
  "_consumers": ["ems_transformer", "airos-energy-decision", "agentleague", "energy-decision-studio", "building-energy-3d"],
  "version": "2.0",
  "updated": "2026-09-22",
  "type": "object",
  "additionalProperties": false,
  "required": ["asker", "target", "query"],
  "properties": {
    "contract": {"const": "airo-request/v2"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 120, "description": "호출자가 주는 요청 번호. 없으면 서버가 봉투 해시로 짓는다"},
    "asker": {"$ref": "#/$defs/Asker"},
    "target": {"$ref": "#/$defs/Target"},
    "period": {"$ref": "#/$defs/Period"},
    "query": {"type": "string", "minLength": 1, "maxLength": 4000, "description": "질문 원문"},
    "surface": {"enum": ["mcp", "studio", "lab", "airos", "agentleague"]}
  },
  "$defs": {
    "Asker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login_id"],
      "properties": {
        "login_id": {"type": "string", "pattern": "^[a-z]+\\.[a-z_]+\\.[0-9]{3}$"},
        "alias": {"type": ["string", "null"], "maxLength": 60},
        "persona": {"type": ["string", "null"], "pattern": "^P-[A-Z]{2,5}$"},
        "id_source": {"enum": ["airos_session", "declared"], "description": "세션이 있으면 서버가 airos_session 으로 덮어쓴다. declared 는 검증됨이 아니다"}
      }
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ids"],
      "properties": {
        "kind": {"enum": ["asset", "portfolio", "building", "region", "archetype"]},
        "ids": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string"}},
        "label": {"type": ["string", "null"], "maxLength": 60},
        "source": {"enum": ["query", "selection", "previous", "user_default", "login_assignment", "auto_first", "chain_step"]},
        "archetype": {"$ref": "#/$defs/Archetype"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "asset"}}}, "then": {"properties": {"ids": {"items": {"pattern": "^AIR-(BLD|FAC|HOM|RET)-[0-9]{3,4}$"}}}}},
        {"if": {"properties": {"kind": {"const": "portfolio"}}}, "then": {"properties": {"ids": {"items": {"pattern": "^AIR-PRT-[0-9]{3,4}$"}}}}},
        {"if": {"properties": {"kind": {"const": "building"}}}, "then": {"properties": {"ids": {"items": {"pattern": "^[0-9]{25}$"}}}}},
        {"if": {"properties": {"kind": {"const": "region"}}}, "then": {"properties": {"ids": {"items": {"pattern": "^region:[0-9]{2}([0-9]{3})?$"}}}}},
        {"if": {"properties": {"kind": {"const": "archetype"}}}, "then": {"required": ["archetype"], "properties": {"ids": {"items": {"pattern": "^archetype:[A-Za-z0-9_]+$"}}}}}
      ],
      "description": "필지번호(19자리)는 대상이 아니다 — 필지 화면의 조회 열쇠로만. ms-·원천 코드·BE-3D 정수 패킷 번호는 서버 안에서만."
    },
    "Archetype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building_type"],
      "properties": {
        "building_type": {"type": "string"},
        "hvac": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "derived_from": {"type": ["string", "null"], "description": "로그인 배정 건물에서 자동 연결했으면 그 AIR id(기록된 원형). 없으면 가상 건물"}
      }
    },
    "Period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {"type": ["string", "null"], "maxLength": 200, "description": "LLM 이 주는 유일한 기간 값 — 질문 원문의 부분 문자열"},
        "start": {"type": ["string", "null"], "format": "date-time"},
        "end_exclusive": {"type": ["string", "null"], "format": "date-time"},
        "tz": {"const": "Asia/Seoul"},
        "grain": {"enum": ["hour", "day", "month", "year", null]},
        "basis": {"enum": ["question_literal", "recent_n_from_data_end", "subject_default", "client_selection", null]}
      },
      "description": "서버의 단일 파서가 text 를 start·end_exclusive·grain·basis 로 정규화한다. LLM 은 정규화 값을 직접 주지 않는다(날짜를 지어내지 않게)."
    }
  }
}
