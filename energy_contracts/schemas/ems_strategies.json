{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-contracts/ems_strategies.json",
  "title": "EMS Strategies",
  "description": "EMS 전략 코드 SSOT (M00~M20). M00~M20=시뮬 EMS(NAMING §1.1), M16~M20=DR 제어 액션. ADR-EMS-NAMESPACE-UNIFY. 모든 모듈은 이 정의를 참조.",
  "_usage": "codegen",
  "_consumers": [
    "edge-agent",
    "gridbridge",
    "building-energy-3d",
    "agentleague",
    "eduarena"
  ],
  "version": "3.5",
  "$comment": "3.5(2026-10-01 · EC 0.3.74 — 캠페인 scratch/capability_first/EC_ROWS_NEEDED_round3.md E4-1 · E5-1 · requests_round1.md WP2 §4 · 가산): strategies[*].easy_name_kr(쉬운 이름 — 조합은 easy_name_rule 로 구성 대책의 쉬운 이름을 잇는다) · 단일 전략 setpoint_action(어휘 setpoint_actions — 조합은 싣지 않고 구성에서 파생) · applies_when(적용 전제 — 어휘 applicability_conditions). 3.4 의 키·값·문구는 그대로. 어휘와 가리키는 열쇠는 scripts/vocabulary_gate.py 가 적재 때 본다.",
  "$defs": {
    "StrategyCode": {
      "type": "string",
      "enum": [
        "M00",
        "M01",
        "M02",
        "M03",
        "M04",
        "M05",
        "M06",
        "M07",
        "M08",
        "M09",
        "M10",
        "M11",
        "M12",
        "M13",
        "M14",
        "M15",
        "M16",
        "M17",
        "M18",
        "M19",
        "M20",
        "M21",
        "M22"
      ],
      "description": "통일 EMS 전략 코드 (23종, M00~M22). M00~M20=시뮬 EMS(NAMING §1.1), M16~M20=DR 제어 액션(ADR-EMS-NAMESPACE-UNIFY), M21~M22=시뮬 확장 전략(ThermalStorage/PV 자가소비, 2026-07-10 승격)."
    },
    "ObjectiveType": {
      "type": "string",
      "enum": [
        "reliability",
        "economic",
        "carbon",
        "optimal"
      ],
      "description": "운영 목적(objective) 축 — APE 운영 프로파일 · signal_mapping_dr dr_type · dr_dispatch_event.DispatchSource(∪ microgrid_safety) 의 단일 SSOT (R18 Item 1). reliability=신뢰성 우선 / economic=비용최적 / carbon=탄소최소 / optimal=통합 균형. dr_dispatch_event.json 은 이 enum 을 재사용(DispatchSource = ObjectiveType ∪ {microgrid_safety}); validate_ssot.check_objective_dispatch_sync 가 동기 강제."
    },
    "SignalDrMapping": {
      "type": "object",
      "description": "한 SignalLevel 에서 objective(ObjectiveType) 별 전략 코드. 4 objective 전부 필수.",
      "required": [
        "reliability",
        "economic",
        "carbon",
        "optimal"
      ],
      "properties": {
        "reliability": {
          "$ref": "#/$defs/StrategyCode"
        },
        "economic": {
          "$ref": "#/$defs/StrategyCode"
        },
        "carbon": {
          "$ref": "#/$defs/StrategyCode"
        },
        "optimal": {
          "$ref": "#/$defs/StrategyCode"
        }
      },
      "additionalProperties": false
    },
    "PersonaStrategy": {
      "type": "object",
      "description": "한 운영 프로파일(objective)의 기본 전략 — 상시(normal)·피크(peak) M-code + ESS 예비율. APE 가 objective 해석 시 사용.",
      "required": [
        "normal",
        "peak",
        "ess_reserve_pct"
      ],
      "properties": {
        "normal": {
          "$ref": "#/$defs/StrategyCode"
        },
        "peak": {
          "$ref": "#/$defs/StrategyCode"
        },
        "ess_reserve_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "피크 대비 유지할 ESS 최소 예비율(%). reliability↑ → 예비 보수적, economic/carbon → 적극 방전."
        }
      },
      "additionalProperties": false
    },
    "OpMode": {
      "type": "string",
      "enum": [
        "occupied",
        "night",
        "weekend",
        "peak",
        "emergency"
      ],
      "description": "건물 운영 모드(BEMS 스케줄 구간 축) — bems-console lib/presets.ts OpMode 의 단일 SSOT. occupied=근무중(업무시간 점유) / night=야간(비점유·셋백) / weekend=주말(휴일·최소) / peak=피크(수요반응·부하감축) / emergency=비상(안전 우선). 콘솔이 시간구간(from~to)에 이 모드를 저작 → provision → edge ScheduleRunner 가 opmode_strategy_map 으로 M-code 해석해 실행."
    }
  },
  "type": "object",
  "properties": {
    "strategies": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/StrategyCode"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name_en": {
            "type": "string"
          },
          "name_kr": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "combined"
            ],
            "description": "단일 전략 vs 복합 전략"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/StrategyCode"
            },
            "description": "복합 전략의 구성 요소 (single은 빈 배열)"
          },
          "observable_signature": {
            "type": "object",
            "required": [
              "metric",
              "op",
              "threshold"
            ],
            "description": "실측 시간 부하 모양에서 이 전략의 흔적을 읽는 판정 규칙(선언 — 0.3.72 요청 C9). 없는 전략 = '판정 규칙 없음'(짐작하지 않는다)",
            "properties": {
              "metric": {
                "type": "string"
              },
              "definition_ko": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "lt",
                  "le",
                  "gt",
                  "ge",
                  "within"
                ]
              },
              "threshold": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                ]
              },
              "high": {
                "type": "number"
              },
              "params": {
                "type": "object"
              },
              "confidence": {
                "type": "object"
              },
              "classification": {
                "type": "string"
              },
              "basis_kind": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          },
          "easy_name_kr": {
            "type": "string",
            "description": "쉬운 이름(사람 대면 표·요약 — 정본 이름은 name_kr). 조합(combined)은 default.easy_name_rule 로 구성 대책의 쉬운 이름을 components 순서로 이은 글이다(손으로 따로 짓지 않는다 — 적재 검사가 같은지 본다)"
          },
          "setpoint_action": {
            "type": "string",
            "description": "단일 전략이 설정온도를 어떻게 움직이나(어휘 = default.setpoint_actions.values 의 열쇠). 조합(combined)에는 싣지 않는다(구성 대책에서 파생)"
          },
          "applies_when": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "대상에 이 전략이 뜻이 있으려면 있어야 할 전제(어휘 = default.applicability_conditions.values 의 열쇠 — 모두 만족해야 한다). 칸이 없으면 선언된 전제가 없다는 뜻이다('늘 된다'는 주장이 아니다)"
          }
        },
        "required": [
          "name_en",
          "name_kr",
          "type",
          "components"
        ]
      }
    },
    "signal_mapping": {
      "type": "object",
      "description": "DR SignalLevel → 기본 전략 매핑 (flat, fallback). dr_type 컨텍스트 없을 때 사용.",
      "properties": {
        "NORMAL": {
          "$ref": "#/$defs/StrategyCode"
        },
        "MODERATE": {
          "$ref": "#/$defs/StrategyCode"
        },
        "HIGH": {
          "$ref": "#/$defs/StrategyCode"
        },
        "EMERGENCY": {
          "$ref": "#/$defs/StrategyCode"
        }
      }
    },
    "signal_mapping_dr": {
      "type": "object",
      "description": "DR SignalLevel → 전략 매핑, objective(dr_type)별 분기 (Phase 4 도입, R18 Item 1 에서 2 objective→4 objective 확장). esg_policy.dr_type / APE 운영 프로파일 ∈ ObjectiveType {reliability,economic,carbon,optimal} 시 사용. 4 SignalLevel × 4 objective = 16 키 모두 필수. Fallback 체인: signal_mapping_dr.{level}.{objective} 정의 누락(신규 carbon/optimal 포함) 시 → signal_mapping_dr.{level}.reliability (보수적 가정) → signal_mapping.{level} (flat) → M00. dr_agent / APE loader 가 startup 시 16 키 모두 존재 검증(edge·be-3d 소관; GB 는 DispatchSource 생성측이라 본 매핑 비소비).",
      "required": [
        "NORMAL",
        "MODERATE",
        "HIGH",
        "EMERGENCY"
      ],
      "properties": {
        "NORMAL": {
          "$ref": "#/$defs/SignalDrMapping"
        },
        "MODERATE": {
          "$ref": "#/$defs/SignalDrMapping"
        },
        "HIGH": {
          "$ref": "#/$defs/SignalDrMapping"
        },
        "EMERGENCY": {
          "$ref": "#/$defs/SignalDrMapping"
        }
      },
      "additionalProperties": false
    },
    "persona_strategy_map": {
      "type": "object",
      "description": "APE 운영 프로파일(objective) → 기본 전략(상시/피크 M-code + ESS 예비율) 매핑 (R18 Item 1). ObjectiveType 4종 전부 필수. APE 가 dr_dispatch_event 없이 자율 운영할 때의 기본 프로파일. peak M-code 는 SignalLevel HIGH/EMERGENCY 시 참고값(실제 발령은 signal_mapping_dr 우선).",
      "required": [
        "reliability",
        "economic",
        "carbon",
        "optimal"
      ],
      "properties": {
        "reliability": {
          "$ref": "#/$defs/PersonaStrategy"
        },
        "economic": {
          "$ref": "#/$defs/PersonaStrategy"
        },
        "carbon": {
          "$ref": "#/$defs/PersonaStrategy"
        },
        "optimal": {
          "$ref": "#/$defs/PersonaStrategy"
        }
      },
      "additionalProperties": false
    },
    "opmode_strategy_map": {
      "type": "object",
      "description": "건물 운영 모드(OpMode) → 기본 EMS 전략(M-code) 매핑. bems-console 이 스케줄 구간에 저작한 OpMode 를 edge ScheduleRunner 가 실행 가능한 M-code 로 해석하는 SSOT. OpMode 5종 전부 필수. peak/emergency 는 signal_mapping_dr(DR 발령) 우선 — 본 매핑은 DR 신호 부재 시 스케줄 자율 운영 기본값. 건물 고유 override 는 provision schedule.entries[].strategy 로 개별 지정 가능(본 매핑은 미지정 시 폴백).",
      "required": [
        "occupied",
        "night",
        "weekend",
        "peak",
        "emergency"
      ],
      "properties": {
        "occupied": {
          "$ref": "#/$defs/StrategyCode"
        },
        "night": {
          "$ref": "#/$defs/StrategyCode"
        },
        "weekend": {
          "$ref": "#/$defs/StrategyCode"
        },
        "peak": {
          "$ref": "#/$defs/StrategyCode"
        },
        "emergency": {
          "$ref": "#/$defs/StrategyCode"
        }
      },
      "additionalProperties": false
    },
    "dr_assumptions": {
      "type": "object",
      "description": "수요반응(DR) 계열 M16~M20 의 **정본 산식과 가정값**(2026-09-28 등재). 가정 등급 — 실측·시뮬 근거가 아니다(data_source=imputed, display_class=estimated). kW 절감 = 감축 분율 × 대상 부하(kW) 를 이벤트 구간에서만 적용한다. 서빙 수치를 낼 때는 가정임을 응답에 싣는다. M16 은 이름(DR 야간 셋백·능동 부하감축)에 맞는 이벤트형 산식이 정본이고, 같은 코드로 불리던 다른 두 산식은 variants 에 '변형'으로 기록한다.",
      "required": [
        "evidence_grade",
        "data_source",
        "display_class",
        "method",
        "as_of",
        "event_window_default",
        "night_window_default",
        "strategies"
      ],
      "properties": {
        "evidence_grade": {
          "type": "string",
          "const": "assumption"
        },
        "data_source": {
          "type": "string",
          "description": "data_classification.json#DataSource — 우리가 채운 가정 = imputed."
        },
        "display_class": {
          "type": "string",
          "description": "data_classification.json#EvidenceDisplayClass — estimated."
        },
        "method": {
          "type": "string",
          "description": "imputed 값의 산정 방법(DataSource=imputed 는 method 필수)."
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "event_window_default": {
          "type": "object",
          "description": "질의가 시간대를 주지 않을 때 쓰는 DR 이벤트 기본 구간(현지 시각).",
          "required": [
            "weekdays_only",
            "months",
            "start",
            "end",
            "source"
          ],
          "properties": {
            "weekdays_only": {
              "type": "boolean"
            },
            "months": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            },
            "start": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "end": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "source": {
              "type": "string"
            },
            "source_url": {
              "type": "string"
            },
            "source_date": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "night_window_default": {
          "type": "object",
          "description": "M16 의 야간 창 기본값(현지 시각, 자정 넘김 허용).",
          "required": [
            "start",
            "end",
            "source"
          ],
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "end": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "strategies": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "M16",
              "M17",
              "M18",
              "M19",
              "M20"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "formula_id",
              "formula",
              "controlled_load",
              "source"
            ],
            "properties": {
              "formula_id": {
                "type": "string"
              },
              "formula": {
                "type": "string"
              },
              "controlled_load": {
                "type": "string",
                "enum": [
                  "hvac",
                  "lights",
                  "hvac+lights",
                  "ess",
                  "hvac_proxy+lights+ess"
                ]
              },
              "depth": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "대상 부하 감축 분율(0~1)."
              },
              "lighting_depth": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "hvac_proxy_depth": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "hvac_proxy_depth_absence": {
                "type": "string",
                "description": "data_classification.json#AbsenceKind — 값이 없을 때 그 이유."
              },
              "ess_power_frac_of_annual_peak": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ess_duration_h": {
                "type": "number",
                "minimum": 0
              },
              "comfort_sign": {
                "type": "integer",
                "enum": [
                  -1,
                  0,
                  1
                ],
                "description": "재실 쾌적 영향 부호(−1=악화)."
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string"
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "where",
                    "formula",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "where": {
                      "type": "string"
                    },
                    "formula": {
                      "type": "string"
                    },
                    "used_by": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "const": "variant"
                    }
                  }
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "reconciliation_note": {
          "type": "string",
          "description": "등재 시 대조한 다른 자리의 값과 차이(기록)."
        }
      }
    },
    "legacy_mapping": {
      "type": "object",
      "description": "구 코드 → 통일 코드 매핑 (읽기 전용, 신규 작성 금지)",
      "properties": {
        "ems_simulation": {
          "type": "object"
        },
        "gcs_e_codes": {
          "type": "object",
          "description": "GENERATED — 손편집 금지. legacy_ems_code_mapping.json#deprecated_e_codes[*].maps_to 의 투영이다(scripts/legacy_e_codes.py, gen_constants.py --all 이 동기화). 뜻(다중 M)은 그 표의 components 를 읽는다."
        },
        "ems_transformer_sc": {
          "type": "object"
        }
      }
    },
    "kbep_fast_path": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "KBEP 대리모형이 학습한 전략(정수 id = M 번호). 그 밖(M16~M22)은 fast-path 값이 없다 — 게이트웨이 DR 가드와 같은 선."
    },
    "setpoint_actions": {
      "type": "object",
      "description": "설정온도 동작 어휘(values) · 규칙 · 근거"
    },
    "applicability_conditions": {
      "type": "object",
      "description": "적용 전제 어휘(values — 전제마다 판정에 쓰는 대상 사실) · 규칙 · 근거"
    },
    "easy_name_rule": {
      "type": "object",
      "description": "조합 전략의 쉬운 이름을 잇는 규칙(머리 · 잇는 글)"
    }
  },
  "default": {
    "strategies": {
      "M00": {
        "name_en": "Baseline",
        "name_kr": "고정 설정온도 + 야간 설정 완화(셋백)",
        "type": "single",
        "components": [],
        "observable_signature": {
          "metric": "night_to_day_ratio",
          "definition_ko": "시간 부하 모양(평일 — 없으면 전체)의 밤 평균 ÷ 낮 평균 — 밤 = [0, 6)시 · 낮 = [9, 18)시(끝 시각 제외)",
          "op": "lt",
          "threshold": 0.5,
          "params": {
            "night_hours": [
              0,
              6
            ],
            "day_hours": [
              9,
              18
            ]
          },
          "confidence": {
            "met": "medium",
