{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-contracts/target_vocabulary.json",
  "title": "Target Vocabulary",
  "description": "대상(누구의 무엇을 묻나) 어휘 정본(2026-09-28 일반화 G1). AIR 자산 종류마다 어느 대상 칸으로 가는지·건물번호를 갖는지·시계열을 갖는지를 한 표로 둔다 — 같은 사실을 게이트웨이 두 목록(BUILDING_ASSET=BLD·FAC·RET ↔ ASSET_WITH_SERIES=BLD·FAC·HOM·RET)이 다르게 말해 확인된 가정 15곳이 공공 건물 도구에서 거절됐다. 식별자 정규식은 common.json $defs(BuildingMgmtNo·ParcelId·AirAssetId …) 한 곳이다.",
  "_usage": "codegen",
  "_consumers": [
    "ems_transformer (G3 대상 해석기)",
    "airos-energy-decision",
    "energy-decision-studio",
    "building-energy-3d",
    "agentleague"
  ],
  "version": "1.1",
  "updated": "2026-09-30",
  "$defs": {
    "AirAssetKindEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_ko",
        "target_kind",
        "subject_field",
        "building_number",
        "has_series"
      ],
      "properties": {
        "label_ko": {
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "asset",
            "portfolio"
          ]
        },
        "subject_field": {
          "enum": [
            "building_ids",
            "home_ids",
            "portfolio_ids"
          ]
        },
        "building_number": {
          "enum": [
            "registry_confirmed",
            "not_applicable"
          ],
          "description": "registry_confirmed = 원장에 확인된 25자리 번호가 있을 때만 쓴다(없으면 이름 있는 거절 — 필지로 대체 금지)"
        },
        "has_series": {
          "type": "boolean",
          "description": "자산 자체의 계측 시계열이 있는가(포트폴리오는 구성원 계열)"
        },
        "archetype_source": {
          "enum": [
            "record",
            "registry_usage",
            "members"
          ]
        },
        "aliases_ko": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "그 자산 종류를 가리키는 일상 이름(label_ko 밖) — '내 것' 을 가리키는 말(소유 표현 × 자산 명사)의 자산 명사. 한 이름은 한 종류에만(적재 때 scripts/vocabulary_gate.py 가 겹침을 거절)"
        }
      }
    }
  },
  "type": "object",
  "default": {
    "electricity_price_classes": {
      "general_low_voltage": {"label_ko": "일반용(갑)Ⅰ 저압 계절 전력량요금", "market_prices_ref": "retail_reference_2026.electricity_energy_charge_general_low_voltage_2026", "needs_month": true},
      "general": {"label_ko": "일반용 평균판매단가", "market_prices_ref": "retail_reference_2026.electricity_avg_sales_price.general", "needs_month": false},
      "industrial": {"label_ko": "산업용 평균판매단가", "market_prices_ref": "retail_reference_2026.electricity_avg_sales_price.industrial", "needs_month": false},
      "residential": {"label_ko": "주택용 평균판매단가", "market_prices_ref": "retail_reference_2026.electricity_avg_sales_price.residential", "needs_month": false},
      "education_2024": {"label_ko": "교육용 평균판매단가(2024)", "market_prices_ref": "retail_reference_2026.electricity_avg_sales_price.education_2024", "needs_month": false},
      "education_use_types": ["school", "education"],
      "rule_ko": "자산 종류 → 요금 종별(air_asset_kinds[*].electricity_price_class): 점포 = 저압 계절 단가 · 건물 = 일반용 · 공장 = 산업용 · 가정 = 주택용. 용도가 교육(education_use_types)이면 교육용이 먼저. 모르는 종류는 종별 없음(참조 단가 unit_prices 를 쓰고 표시) — 계약 요금이 아니다",
      "source": "게이트웨이 general_ops/_financial.PRICE_CLASS_BY_KIND·EDUCATION_USE_TYPES·PRICE_CLASS_KO(2026-09-28 W5 선택 규칙) 이관"
    },
    "air_asset_kinds": {
      "BLD": {
        "electricity_price_class": "general",
        "label_ko": "건물",
        "target_kind": "asset",
        "subject_field": "building_ids",
        "building_number": "registry_confirmed",
        "has_series": true,
        "archetype_source": "record",
        "aliases_ko": ["사옥", "빌딩"]
      },
      "FAC": {
        "electricity_price_class": "industrial",
        "label_ko": "공장",
        "target_kind": "asset",
        "subject_field": "building_ids",
        "building_number": "registry_confirmed",
        "has_series": true,
        "archetype_source": "record"
      },
      "HOM": {
        "electricity_price_class": "residential",
        "label_ko": "가정",
        "target_kind": "asset",
        "subject_field": "home_ids",
        "building_number": "registry_confirmed",
        "has_series": true,
        "archetype_source": "registry_usage",
        "aliases_ko": ["집"]
      },
      "RET": {
        "electricity_price_class": "general_low_voltage",
        "label_ko": "점포",
        "target_kind": "asset",
        "subject_field": "building_ids",
        "building_number": "registry_confirmed",
        "has_series": true,
        "archetype_source": "record",
        "aliases_ko": ["매장", "가게", "지점"]
      },
      "PRT": {
        "electricity_price_class": null,
        "label_ko": "포트폴리오",
        "target_kind": "portfolio",
        "subject_field": "portfolio_ids",
        "building_number": "not_applicable",
        "has_series": false,
        "archetype_source": "members"
      }
    },
    "target_kind_id": {
      "asset": "AirAssetId",
      "portfolio": "AirPortfolioId",
      "building": "BuildingMgmtNo",
      "region": "RegionId",
      "archetype": "ArchetypeCode"
    },
    "sources": {
      "air_asset_kinds": "게이트웨이 airo_request_v2._ASSET_FIELD · query_airos_identity._CLASSES_BY_FIELD · airos_store_bridge.ASSET_WITH_SERIES 대조(2026-09-28). HOM 의 건물번호 = 확인된 가정 15곳(B18 결속)."
    }
  }
}
