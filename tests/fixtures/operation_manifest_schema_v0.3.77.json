{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy-contracts/operation_manifest.json",
  "title": "Operation Manifest",
  "description": "연산 매니페스트 스키마(2026-09-28 일반화 G1). 연산마다 '필요한 사실'(needs)을 선언하면 기본 기간·입력 목록·가정이 파생된다 — 연산 이름에 건 손 표 7개(REPLAY_DEFAULT_PERIOD·OPERATION_CRITERIA·OPERATION_INPUTS …)를 대신한다. 내용(operations)은 게이트웨이 세션(3b)이 G4 에서 채운다 — 지금은 빈 표이고, 빈 표를 '선언 완료'로 세지 않는다.",
  "_usage": "reference-only",
  "_consumers": [
    "ems_transformer (store_operations_brief · G4)"
  ],
  "version": "0.1",
  "updated": "2026-09-28",
  "$defs": {
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs",
        "default_period"
      ],
      "properties": {
        "needs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "필요한 사실 종류(예 hourly_load·anomaly_label.strong·outdoor_temp·indoor_temp)"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "judgement_thresholds.json 의 경로(예 comfort.indoor_max_c)"
        },
        "day_window": {
          "type": [
            "string",
            "null"
          ],
          "description": "calendar_conventions.json#default.day_windows 이름"
        },
        "default_period": {
          "enum": [
            "coverage_of_needs",
            "ask"
          ],
          "description": "질문·요청 칩이 기간을 말하지 않을 때: needs 가 모두 제공되는 기간의 교집합, 아니면 되묻기"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "absence_when_missing": {
          "enum": [
            "missing",
            "not_applicable"
          ]
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "operations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Operation"
      }
    }
  },
  "default": {
    "operations": {}
  }
}
