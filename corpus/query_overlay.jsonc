      "expectAny": ["mountMetricChoropleth", "mountSeoulChoropleth", "selectBuildings"],
      "refuseOk": true,   // "지도로" = gateway refuse 하드룰 → compose 경로 정상
      "note": "다지표 제네릭 choropleth"
    },
    "mountSeoulChoropleth": {
      "probeQuery": "서울 25개 구 건물 노후도 분포를 지도로 보여줘",
      "expectAny": ["mountSeoulChoropleth", "mountMetricChoropleth"],
      "refuseOk": true,
      "note": "서울 25구 노후도 고도 사다리 Tier ②"
    },
    "mountNationalChoropleth": {
      "probeQuery": "전국 시도별 건물 밀도를 지도로 보여줘",
