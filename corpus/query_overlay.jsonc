    { "id": "S5", "query": "강남구 분석 지도와 8단계 의사결정을 동시에 보여줘", "queryVariants": [], "route": "cap", "expectAny": ["mountMetricChoropleth","cameraFlyToAnchor"], "refuseOk": false },
    { "id": "S6", "query": "조치별 한계저감비용을 계단막대로 시각화해줘", "queryVariants": [], "route": "cap", "expectAny": ["apply_policy_lever","policy_evaluate"], "refuseOk": false },

    { "id": "L1", "query": "광화문에서 롯데타워까지 차량으로 주행 시연해줘", "queryVariants": [], "route": "compose", "expectAny": ["driveRouteByIntent"], "refuseOk": false },
    { "id": "L2", "query": "이 건물 옥상에 태양광 패널을 배치하고 발전량 시뮬레이션해줘", "queryVariants": [], "route": "compose", "expectAny": ["placeRoofSolar"], "refuseOk": false },
    { "id": "L3", "query": "건물 외벽에 수직 녹화를 시뮬레이션해줘", "queryVariants": [], "route": "compose", "expectAny": [], "refuseOk": true },
    { "id": "L4", "query": "방금 그린 지도에서 CO2 대신 전기 소비로 바꿔줘", "queryVariants": [], "route": "compose", "expectAny": ["mountMetricChoropleth"], "refuseOk": true },
    { "id": "L5", "query": "강남 전체를 조감한 뒤 삼성동 빌딩군으로 날아가줘", "queryVariants": [], "route": "compose", "expectAny": ["cameraFlyToAnchor"], "refuseOk": false },
    { "id": "L6", "query": "강남 CO2 상위 10건물을 순서대로 투어해줘", "queryVariants": [], "route": "compose", "expectAny": ["tourSelected","selectBuildings","cameraFlyToAnchor"], "refuseOk": false }
  ],

  // ── refuse/off-domain 대표(사냥꾼 Class B 회귀 감시) ─────────────────────────
  "refuseProbes": [
