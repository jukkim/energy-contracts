      "expectAny": ["paintLotteFacadeOnScreenCenter", "paintLotteFacade"], "route": "compose", "refuseOk": false
    },
    "paintRoofFireZone": {
      "probeQuery": "옥상 화재 위험 구역을 표시해줘",
      "expectAny": ["paintRoofFireZone"], "route": "compose", "refuseOk": false
    },
    "placeAsset": {
      "probeQuery": "길가에 벤치랑 가로수를 놓아줘",
      "expectAny": ["placeAsset"], "route": "compose", "refuseOk": false
    },
    "placeSmartLamp": {
      "probeQuery": "스마트 가로등을 세워줘",
      "expectAny": ["placeSmartLamp", "placeAsset"], "route": "compose", "refuseOk": false
    },
    "placeWaterBody": {
      "probeQuery": "이 자리에 분수 있는 광장을 만들어줘",
      "expectAny": ["placeWaterBody", "placeAsset"], "route": "compose", "refuseOk": false
    },
    "placeUndergroundParking": {
      "probeQuery": "지하주차장을 배치해줘",
      "expectAny": ["placeUndergroundParking"], "route": "compose", "refuseOk": false
    },
    "placeLotteTowerAt": {
      "probeQuery": "이 빈 땅에 롯데타워를 세워줘",
      "expectAny": ["placeLotteTowerAt", "swapToLotteTowerAt"], "route": "compose", "refuseOk": false
    },
    "swapToLotteTowerAt": {
      "probeQuery": "이 건물을 롯데타워로 바꿔줘",
      "expectAny": ["swapToLotteTowerAt", "placeLotteTowerAt"], "route": "compose", "refuseOk": false
    },
    "swapBuildingAt": {
      "probeQuery": "이 건물을 다른 박스 건물로 교체해줘",
      "expectAny": ["swapBuildingAt", "swapToLotteTowerAt"], "route": "compose", "refuseOk": false
    },
    "runGangnamScene": {
      "probeQuery": "강남 데모 장면을 재생해줘",
      "expectAny": ["runGangnamScene", "startGangnamCamera"], "route": "compose", "refuseOk": false
    },
    "startGangnamCamera": {
      "probeQuery": "강남 데모 카메라를 시작해줘",
      "expectAny": ["startGangnamCamera", "runGangnamScene"], "route": "compose", "refuseOk": false
    },
    "startCitysetPreset": {
      "probeQuery": "도시 프리셋을 한꺼번에 가동해줘",
      "expectAny": ["startCitysetPreset", "runGangnamScene"], "route": "compose", "refuseOk": false
    },
    "startGoldFaceSliding": {
      "probeQuery": "금색 면이 미끄러지는 연출을 시작해줘",
      "expectAny": ["startGoldFaceSliding"], "route": "compose", "refuseOk": false
    },
    "demoMetroFaceTier": {
      "probeQuery": "광역시 도로 접면 등급 시연을 보여줘",
      "expectAny": ["demoMetroFaceTier", "mountBftDropdown"], "route": "compose", "refuseOk": false
    },
    "impactRollup": {
      "probeQuery": "선택한 건물들의 그린리모델링 정책효과를 합계로 보여줘",
      "expectAny": ["impactRollup", "showAnalysis"], "route": "compose", "refuseOk": false
    }
  },

  // ── ① capability 대표 질의 (studio 7 executor — 게이트웨이 라우팅 hit) ──────
  //   43 라우터 클래스는 gen_corpus 가 채우고, 여기선 7 executor 대표질의만.
  "capabilityProbes": {
    "apply_policy_lever": {
      "probeQuery": "외기냉방(찬 바깥 공기로 냉방)을 적용하면 서울 절감액을 분석해줘",
      "expectAny": ["apply_policy_lever", "policy_evaluate"], "refuseOk": false
    },
    "counterfactual": {
      "probeQuery": "냉방 설정온도를 24도에서 26도로 올리면 절감이 얼마나 달라지나 히트맵으로 보여줘",
      "expectAny": ["counterfactual", "policy_evaluate"], "refuseOk": false
    },
    "recommend_retrofit": {
      "probeQuery": "이 건물에 가장 효과적인 개선 대책을 추천해줘",
      "expectAny": ["ems_recommend", "apply_policy_lever"], "refuseOk": false
    },
    "identify_ems": {
      "probeQuery": "이 건물의 에너지 낭비 지점을 식별해줘",
      "expectAny": ["ems_identify", "ems_diagnose"], "refuseOk": false
    },
    "forecast_24h": {
      "probeQuery": "이 건물의 향후 24시간 전력 수요를 예측해줘",
      "expectAny": ["forecast_24h", "load_predict"], "refuseOk": false
    },
    "diagnose_anomaly": {
      "probeQuery": "이 건물 전력 사용에서 이상 징후를 진단해줘",
      "expectAny": ["diagnose_anomaly", "anomaly", "ems_diagnose"], "refuseOk": false
    },
    "mpc_optimize": {
      "probeQuery": "이 건물 냉난방을 모델예측제어로 최적 운전 스케줄을 짜줘",
      "expectAny": ["mpc_optimize", "mpc", "ems_optimize"], "refuseOk": false
    }
  },

  // ── ②③ 대표 지역·건물·차원 픽스처 (사용자 요구: '건물/지역/국가별 대표 지역') ─
  //   nation/regions = be-3d region_camera.ts(35) 에서 파생; 여기선 '대표 서브셋' 선정만.
  "fixtures": {
    "nation": [
      { "id": "11", "label": "서울 전체", "tier": "sido",   "why": "시도 격자집계(agg=grid) 경로 대표" },
      { "id": "KR", "label": "전국",     "tier": "nation", "why": "mountNationalChoropleth 경로" }
    ],
    "regions": [
      // 대표 서브셋(combo 기본). --full 시 region_camera.ts 35 전수.
      { "id": "11680", "region": "gangnam", "label": "강남구",     "why": "tdmap 완전커버·데이터 조밀(기준 지역)" },
      { "id": "11440", "region": "mapo",    "label": "마포구",     "why": "energy_grade measured 존재" },
      { "id": "26110", "region": "busan",   "label": "부산 중구",  "why": "비수도권·face_tier 미커버(정직 열화 검증)" },
      { "id": "27260", "region": "daegu",   "label": "대구 수성구", "why": "지방 대도시·tdmap 커버" }
    ],
    "buildings": [
      // 공개 데이터/아키타입만. 비공개 실측 PNU 금지(private-data-disclosure).
      { "name": "롯데호텔서울", "archetype": "large_hotel|A", "why": "NER compound·large_hotel v3 커버" },
      { "archetype": "midrise_apartment|HF", "why": "한국형 공조 setpoint 감응 정상셀(K-14 대조군)" },
      { "archetype": "primary_school|HE",    "why": "온돌(HE) 감응 정상셀" },
      { "archetype": "large_office|A",       "why": "F14 기존 기본(냉방 -1.96% 실값·난방 weak — 회귀 감시)" }
    ],
    "dimensions": {
      // metrics = 기계 병합(METRIC_LABEL 15). filters/setpoints/climates/ems = 대표값.
      "filters":   ["무필터", "30층이상", "2000년이전", "업무용"],
      "selOps":    ["top_n", "bottom_n"],
      "selNs":     [50, 200],
      "setpoints": ["c24h20", "c26h20", "c28h20", "c26h18", "c26h22"],
      "climates":  ["baseline", "ssp245_2050", "ssp585_2050", "ssp585_2080"],
      "ems":       ["M00", "M04", "M05", "M09", "M10"]
    }
  },

  // ── ④ 질의 종류(C/S/L) 대표질의 seed — run_qc.py CASES 이관(1:1) ────────────
  //   taxonomy 정본 = studio docs/STUDIO_LAB_QUERY_TAXONOMY.md.
  //   route: cap=gateway /v1/capability-route · compose=studio /api/compose · ops_status=studio GET
  "queryClasses": [
    { "id": "C1", "query": "강남구 건물별 에너지 소비량을 지도로 보여줘", "route": "cap", "expectAny": ["mountMetricChoropleth","mountSeoulChoropleth","selectBuildings"], "refuseOk": true },
    { "id": "C2", "query": "서울 CO2 배출 상위 50개 동을 강조해줘", "route": "cap", "expectAny": ["selectBuildings","mountMetricChoropleth"], "refuseOk": false },
    { "id": "C3", "query": "외기냉방 적용 시 서울 절감액을 분석해줘", "route": "cap", "expectAny": ["apply_policy_lever","policy_evaluate"], "refuseOk": false },
    { "id": "C4", "query": "1980년 이전 지어진 업무용 건물만 보여줘", "route": "cap", "expectAny": ["selectBuildings","mountMetricChoropleth"], "refuseOk": false },
    { "id": "C5", "query": "롯데호텔 서울의 에너지 소비를 보여줘", "route": "cap", "expectAny": ["ems_identify","ems_diagnose","forecast_24h","building_ai"], "refuseOk": false },
    { "id": "C6", "query": "강남구 전기와 가스 소비를 나란히 비교해줘", "route": "cap", "expectAny": ["mountMetricChoropleth","selectBuildings"], "refuseOk": false },
    { "id": "C7", "query": "2050년 온난화 시 이 건물 냉방 부하 변화를 보여줘", "route": "cap", "expectAny": ["climate_scenario","counterfactual"], "refuseOk": false },
    { "id": "C8", "query": "태양광 설치 10년 투자 회수 분석해줘", "route": "cap", "expectAny": ["apply_policy_lever","policy_evaluate"], "refuseOk": false },
    { "id": "C9", "query": "ZEB 의무화 정책의 탄소 절감 효과를 분석해줘", "route": "cap", "expectAny": ["policy_evaluate","apply_policy_lever"], "refuseOk": false },
    { "id": "C10", "query": "마포구 에너지 등급 분포를 보여줘", "route": "cap", "expectAny": ["mountMetricChoropleth","mountSeoulChoropleth"], "refuseOk": false },
    { "id": "C11", "query": "서울과 부산 평균 EUI를 비교해줘", "route": "cap", "expectAny": ["mountMetricChoropleth","selectBuildings"], "refuseOk": false },
    { "id": "C12", "query": "setpoint 변화에 따른 절감 dose-response 히트맵 보여줘", "route": "cap", "expectAny": ["counterfactual"], "refuseOk": false },

    { "id": "S1", "query": "전국 노후도 지도에서 강남구로 확대해줘", "route": "cap", "expectAny": ["mountMetricChoropleth","cameraFlyToAnchor"], "refuseOk": true },
    { "id": "S2", "query": "이 건물 에너지 절감 전략을 8단계로 분석해줘", "route": "cap", "expectAny": ["ems_identify","ems_recommend","ems_diagnose"], "refuseOk": false },
    { "id": "S3", "query": "이 분석 결과를 동료에게 공유할 링크 만들어줘", "route": "cap", "expectAny": [], "refuseOk": true },
    { "id": "S4", "query": "현재 AI 모델 상태와 데이터 출처를 보여줘", "route": "ops_status", "expectAny": [], "refuseOk": false },
    { "id": "S5", "query": "강남구 분석 지도와 8단계 의사결정을 동시에 보여줘", "route": "cap", "expectAny": ["mountMetricChoropleth","cameraFlyToAnchor"], "refuseOk": false },
    { "id": "S6", "query": "조치별 한계저감비용을 계단막대로 시각화해줘", "route": "cap", "expectAny": ["apply_policy_lever","policy_evaluate"], "refuseOk": false },

    { "id": "L1", "query": "광화문에서 롯데타워까지 차량으로 주행 시연해줘", "route": "compose", "expectAny": ["driveRouteByIntent"], "refuseOk": false },
    { "id": "L2", "query": "이 건물 옥상에 태양광 패널을 배치하고 발전량 시뮬레이션해줘", "route": "compose", "expectAny": ["placeRoofSolar"], "refuseOk": false },
    { "id": "L3", "query": "건물 외벽에 수직 녹화를 시뮬레이션해줘", "route": "compose", "expectAny": [], "refuseOk": true },
    { "id": "L4", "query": "방금 그린 지도에서 CO2 대신 전기 소비로 바꿔줘", "route": "compose", "expectAny": ["mountMetricChoropleth"], "refuseOk": true },
    { "id": "L5", "query": "강남 전체를 조감한 뒤 삼성동 빌딩군으로 날아가줘", "route": "compose", "expectAny": ["cameraFlyToAnchor"], "refuseOk": false },
    { "id": "L6", "query": "강남 CO2 상위 10건물을 순서대로 투어해줘", "route": "compose", "expectAny": ["tourSelected","selectBuildings","cameraFlyToAnchor"], "refuseOk": false }
  ],

  // ── refuse/off-domain 대표(사냥꾼 Class B 회귀 감시) ─────────────────────────
  "refuseProbes": [
    { "id": "R-IAQ",   "query": "이 건물 실내공기질 이산화탄소 농도를 진단해줘", "why": "IAQ 미학습 → refuse 게이트" },
    { "id": "R-EQ",    "query": "이 건물의 지진 내진 성능을 평가해줘", "why": "지진/내진 미학습" },
    { "id": "R-THERM", "query": "이 건물 열교와 기밀성을 blower door 로 계산해줘", "why": "열교/기밀 미학습" },
    { "id": "R-FLOOD", "query": "이 지역 침수 홍수 위험을 최적화해줘", "why": "침수/홍수 미학습" },
    { "id": "R-ESS",   "query": "배터리 SOC 기반으로 ESS 충방전을 디스패치 최적화해줘", "why": "ESS SOC 미학습" },
    { "id": "R-WEATHER", "query": "오늘 날씨 알려줘", "why": "완전 비도메인" }
  ]
}
