  // ── ① capability 대표 질의 (studio 7 executor — 게이트웨이 라우팅 hit) ──────
  //   43 라우터 클래스는 gen_corpus 가 채우고, 여기선 7 executor 대표질의만.
  "capabilityProbes": {
    "apply_policy_lever": {
      "probeQuery": "외기냉방(찬 바깥 공기로 냉방)을 적용하면 서울 절감액을 분석해줘",
      "probeQueryVariants": ["외기냉방을 적용하면 얼마나 절약되나", "이 정책을 쓰면 절감액이 얼마야"],
      "expectAny": ["apply_policy_lever", "policy_evaluate"], "refuseOk": false
    },
    "counterfactual": {
      "probeQuery": "냉방 설정온도를 24도에서 26도로 올리면 절감이 얼마나 달라지나 히트맵으로 보여줘",
      "probeQueryVariants": ["설정온도를 2도 올리면 결과가 어떻게 달라져", "온도를 바꿨을 때 절감 차이를 비교해줘"],
      "expectAny": ["counterfactual", "policy_evaluate"], "refuseOk": false
    },
    "recommend_retrofit": {
      "probeQuery": "이 건물에 가장 효과적인 개선 대책을 추천해줘",
      "probeQueryVariants": ["이 건물에 뭘 고치면 좋을지 추천해줘", "개선 공사 우선순위를 알려줘"],
      "expectAny": ["ems_recommend", "apply_policy_lever"], "refuseOk": false
    },
    "identify_ems": {
      "probeQuery": "이 건물의 에너지 낭비 지점을 식별해줘",
      "probeQueryVariants": ["이 건물이 어떤 운전 전략을 쓰고 있어?", "현재 EMS 운영 방식을 식별해줘"],
      "expectAny": ["ems_identify", "ems_diagnose"], "refuseOk": false
    },
    "forecast_24h": {
      "probeQuery": "이 건물의 향후 24시간 전력 수요를 예측해줘",
      "probeQueryVariants": ["내일 하루 전력 수요를 예측해줘", "24시간 부하 예상치를 보여줘"],
      "expectAny": ["forecast_24h", "load_predict"], "refuseOk": false
    },
    "diagnose_anomaly": {
      "probeQuery": "이 건물 전력 사용에서 이상 징후를 진단해줘",
      "probeQueryVariants": ["이 건물 이상 징후를 찾아줘", "평소와 다른 소비 패턴이 있는지 진단"],
      "expectAny": ["diagnose_anomaly", "anomaly", "ems_diagnose"], "refuseOk": false
    },
    "mpc_optimize": {
      "probeQuery": "이 건물 냉난방을 모델예측제어로 최적 운전 스케줄을 짜줘",
      "probeQueryVariants": ["최적 운전 스케줄을 짜줘", "다음 24시간 제어 계획을 최적화해줘"],
      "expectAny": ["mpc_optimize", "mpc", "ems_optimize"], "refuseOk": false
    }
  },

  // ── ②③ 대표 지역·건물·차원 픽스처 (사용자 요구: '건물/지역/국가별 대표 지역') ─
  //   nation/regions = be-3d region_camera.ts(35) 에서 파생; 여기선 '대표 서브셋' 선정만.
  "fixtures": {
    "nation": [
      { "id": "11", "label": "서울 전체", "tier": "sido",   "why": "시도 격자집계(agg=grid) 경로 대표" },
      { "id": "KR", "label": "전국",     "tier": "nation", "why": "mountNationalChoropleth 경로" }
    ],
    "regions": [
      // 대표 서브셋(combo 기본). --full 시 region_camera.ts 35 전수.
      { "id": "11680", "region": "gangnam", "label": "강남구",     "why": "tdmap 완전커버·데이터 조밀(기준 지역)" },
      { "id": "11440", "region": "mapo",    "label": "마포구",     "why": "energy_grade measured 존재" },
      { "id": "26110", "region": "busan",   "label": "부산 중구",  "why": "비수도권·face_tier 미커버(정직 열화 검증)" },
      { "id": "27260", "region": "daegu",   "label": "대구 수성구", "why": "지방 대도시·tdmap 커버" }
    ],
    "buildings": [
      // 공개 데이터/아키타입만. 비공개 실측 PNU 금지(private-data-disclosure).
      { "name": "롯데호텔서울", "archetype": "large_hotel|A", "why": "NER compound·large_hotel v3 커버" },
      { "archetype": "midrise_apartment|HF", "why": "한국형 공조 setpoint 감응 정상셀(K-14 대조군)" },
      { "archetype": "primary_school|HE",    "why": "온돌(HE) 감응 정상셀" },
      { "archetype": "large_office|A",       "why": "F14 기존 기본(냉방 -1.96% 실값·난방 weak — 회귀 감시)" }
    ],
    "dimensions": {
      // metrics = 기계 병합(METRIC_LABEL 15). filters/setpoints/climates/ems = 대표값.
      "filters":   ["무필터", "30층이상", "2000년이전", "업무용"],
      "selOps":    ["top_n", "bottom_n"],
      "selNs":     [50, 200],
      "setpoints": ["c24h20", "c26h20", "c28h20", "c26h18", "c26h22"],
      "climates":  ["baseline", "ssp245_2050", "ssp585_2050", "ssp585_2080"],
      "ems":       ["M00", "M04", "M05", "M09", "M10"]
    }
  },

  // ── ④ 질의 종류(C/S/L) 대표질의 seed — run_qc.py CASES 이관(1:1) ────────────
  //   taxonomy 정본 = studio docs/STUDIO_LAB_QUERY_TAXONOMY.md.
  //   route: cap=gateway /v1/capability-route · compose=studio /api/compose · ops_status=studio GET
  "queryClasses": [
    { "id": "C1", "query": "강남구 건물별 에너지 소비량을 지도로 보여줘", "queryVariants": ["강남구 건물 에너지 사용량 지도", "자치구별 소비량을 색으로 보여줘"], "route": "cap", "expectAny": ["mountMetricChoropleth","mountSeoulChoropleth","selectBuildings"], "refuseOk": true },
    { "id": "C2", "query": "서울 CO2 배출 상위 50개 동을 강조해줘", "queryVariants": ["배출 많은 동네 상위 50곳 표시", "CO2 상위 지역을 강조해줘"], "route": "cap", "expectAny": ["selectBuildings","mountMetricChoropleth"], "refuseOk": false },
    { "id": "C3", "query": "외기냉방 적용 시 서울 절감액을 분석해줘", "queryVariants": ["외기냉방 쓰면 서울 절감액이 얼마", "찬 바깥공기 냉방의 효과를 계산해줘"], "route": "cap", "expectAny": ["apply_policy_lever","policy_evaluate"], "refuseOk": false },
    { "id": "C4", "query": "1980년 이전 지어진 업무용 건물만 보여줘", "queryVariants": ["오래된 업무용 건물만 골라줘", "1980년 이전 사무실 건물 표시"], "route": "cap", "expectAny": ["selectBuildings","mountMetricChoropleth"], "refuseOk": false },
    { "id": "C5", "query": "롯데호텔 서울의 에너지 소비를 보여줘", "queryVariants": ["롯데호텔 에너지 사용량 알려줘", "그 호텔 전기를 얼마나 쓰나"], "route": "cap", "expectAny": ["ems_identify","ems_diagnose","forecast_24h","building_ai"], "refuseOk": false },
    { "id": "C6", "query": "강남구 전기와 가스 소비를 나란히 비교해줘", "queryVariants": ["전기랑 가스를 같이 비교해줘", "두 에너지원을 나란히 보여줘"], "route": "cap", "expectAny": ["mountMetricChoropleth","selectBuildings"], "refuseOk": false },
    { "id": "C7", "query": "2050년 온난화 시 이 건물 냉방 부하 변화를 보여줘", "queryVariants": ["2050년에 냉방이 얼마나 늘까", "미래 기후에서 부하 변화를 보여줘"], "route": "cap", "expectAny": ["climate_scenario","counterfactual"], "refuseOk": false },
    { "id": "C8", "query": "태양광 설치 10년 투자 회수 분석해줘", "queryVariants": ["태양광 넣으면 몇 년에 회수돼", "PV 투자 회수기간 계산"], "route": "cap", "expectAny": ["apply_policy_lever","policy_evaluate"], "refuseOk": false },
    { "id": "C9", "query": "ZEB 의무화 정책의 탄소 절감 효과를 분석해줘", "queryVariants": ["ZEB 의무화하면 탄소가 얼마나 줄어", "제로에너지건축 정책 효과 분석"], "route": "cap", "expectAny": ["policy_evaluate","apply_policy_lever"], "refuseOk": false },
    { "id": "C10", "query": "마포구 에너지 등급 분포를 보여줘", "queryVariants": ["마포구 에너지등급 분포 보여줘", "그 지역 효율등급을 지도로"], "route": "cap", "expectAny": ["mountMetricChoropleth","mountSeoulChoropleth"], "refuseOk": false },
    { "id": "C11", "query": "서울과 부산 평균 EUI를 비교해줘", "queryVariants": ["서울이랑 부산 EUI 비교", "두 도시 에너지원단위를 견줘봐"], "route": "cap", "expectAny": ["mountMetricChoropleth","selectBuildings"], "refuseOk": false },
    { "id": "C12", "query": "setpoint 변화에 따른 절감 dose-response 히트맵 보여줘", "queryVariants": ["설정온도별 절감 히트맵", "온도 바꿀 때마다 절감이 어떻게 변하나"], "route": "cap", "expectAny": ["counterfactual"], "refuseOk": false },

    { "id": "S1", "query": "전국 노후도 지도에서 강남구로 확대해줘", "queryVariants": ["전국 보여주고 강남으로 확대", "전국에서 자치구로 줌인해줘"], "route": "cap", "expectAny": ["mountMetricChoropleth","cameraFlyToAnchor"], "refuseOk": true },
